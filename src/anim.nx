// src/anim.nx — escolhe o frame do jogador. Conhece o layout de
// images/shooter_sheet.png (gerado por tools/pack_sheet.py) e nada da engine:
// devolve linha, coluna e espelhamento, e o render so recorta a celula.
use src.vec as vec
use src.world as wld

let CELL_W = 80.0
let CELL_H = 64.0

// linhas da sheet
let IDLE_DOWN = 0
let WALK_DOWN = 1
let WALK_UP = 2
let WALK_SIDE = 3
let SHOOT_SIDE = 4
let DEATH = 5
let IDLE_SIDE = 6
let FRAMES: int[] = [4, 6, 7, 4, 7, 7, 1]

struct Pose
    row: int,
    col: int,
    flip: bool,            // espelhado: virado para a esquerda
    visible: bool          // false nos quadros apagados do pisca
end

let IDLE_FPS = 4.0
let WALK_FPS = 10.0
let SHOOT_FPS = 15.0
let DEATH_FPS = 10.0
let BLINK_HZ = 15.0        // trocas de visibilidade por segundo

// frame_at percorre a linha em ciclo: o frame vem do relogio de partida, entao
// o passo comeca em fase qualquer, mas nao precisa de estado no render.
func frame_at(row: int, t: float, fps: float) -> int
    return to_int(t * fps) % FRAMES[row]
end

// pose le o World e decide o frame. Para onde o sprite olha vem da mira,
// exceto andando sem atirar, quando vem do passo: a camera trava nas bordas
// da arena e la o jogador passa pelo cursor com facilidade; seguir a mira
// faria o sprite virar para tras no meio da caminhada. A direcao e
// quantizada em quatro: de lado sempre que |x| >= |y|, espelhando para a
// esquerda; senao de frente ou de costas. Nao ha linha de tiro nem idle para
// cima e para baixo, entao la o tiro cai no andar/idle e o parado de costas e
// o frame 0 de andar.
func pose(w: wld.World) -> Pose
    let moving: bool = w.player.move.x != 0.0 || w.player.move.y != 0.0
    let shooting: bool = w.player.fire_cd > 0.0

    let f: vec.V = w.player.aim
    if moving && !shooting then
        f = w.player.move
    end
    let fx: float = f.x
    if fx < 0.0 then
        fx = -fx
    end
    let fy: float = f.y
    if fy < 0.0 then
        fy = -fy
    end
    let side: bool = fx >= fy
    let flip: bool = side && f.x < 0.0

    if w.screen == 2 then
        let fr: int = to_int(w.since_end * DEATH_FPS)
        if fr > FRAMES[DEATH] - 1 then
            fr = FRAMES[DEATH] - 1
        end
        return Pose(DEATH, fr, flip, true)
    end

    let visible: bool = w.player.invuln <= 0.0 || to_int(w.time * BLINK_HZ) % 2 == 0

    if side then
        if shooting then
            return Pose(SHOOT_SIDE, frame_at(SHOOT_SIDE, w.time, SHOOT_FPS), flip, visible)
        end
        if moving then
            return Pose(WALK_SIDE, frame_at(WALK_SIDE, w.time, WALK_FPS), flip, visible)
        end
        return Pose(IDLE_SIDE, 0, flip, visible)
    end

    if f.y < 0.0 then
        if moving then
            return Pose(WALK_UP, frame_at(WALK_UP, w.time, WALK_FPS), false, visible)
        end
        return Pose(WALK_UP, 0, false, visible)
    end

    if moving then
        return Pose(WALK_DOWN, frame_at(WALK_DOWN, w.time, WALK_FPS), false, visible)
    end
    return Pose(IDLE_DOWN, frame_at(IDLE_DOWN, w.time, IDLE_FPS), false, visible)
end

// ---- inimigos: images/enemies_sheet.png, uma caminhada lateral por kind ----
// Inimigos so olham para a esquerda ou para a direita, pelo sinal de vel.x:
// a sheet nao tem vista de costas para o zumbi, e numa horda a lateral
// funciona para cima e para baixo tambem.
let ZOMBIE = 0
let SOLDIER = 1
let ZOMBIE_SOLDIER = 2
let ENEMY_FRAMES: int[] = [4, 4, 4]
let STRIDE = 10.0          // px andados por frame da passada: fps = speed / STRIDE

// enemy_scale so muda o desenho; o raio de colisao mora em make_enemy.
func enemy_scale(kind: int) -> float
    if kind == 1 then
        return 0.85
    end
    if kind == 2 then
        return 1.35
    end
    return 1.0
end

func enemy_pose(e: wld.Enemy, t: float) -> Pose
    let row: int = e.kind
    let n: int = ENEMY_FRAMES[row]
    let col: int = to_int(t * e.speed / STRIDE + e.phase * to_float(n)) % n
    return Pose(row, col, e.vel.x < 0.0, e.flash <= 0.0)
end
