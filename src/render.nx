// src/render.nx — o unico modulo que desenha. O chao e images/background.jpg
// em escala 1:1 com a arena; jogador e inimigos sao frames das sheets em
// images/, escolhidos por src/anim; balas, particulas e HUD sao linha,
// circulo e retangulo. F1 (deadrail.nx) liga o overlay dos obstaculos.
use github_com.estevaofon.noxy_game_engine as game
use src.vec as vec
use src.world as wld
use src.rng as rng
use src.upgrades as up
use src.waves as waves
use src.anim as anim

let BG: game.Color = game.rgb(10, 12, 20)
let WALL: game.Color = game.rgb(70, 84, 130)
let BULLET_C: game.Color = game.rgb(255, 244, 180)
let OBSTACLE_FILL: game.Color = game.rgba(255, 40, 40, 70)
let OBSTACLE_LINE: game.Color = game.rgba(255, 230, 0, 200)
let PLAYER_SCALE = 1.0

let sheet: game.Image = game.Image(0, 0, 0)
let esheet: game.Image = game.Image(0, 0, 0)
let background: game.Image = game.Image(0, 0, 0)
let show_obstacles: bool = false

// load carrega as sheets e o mapa. Tem de vir depois de game.init: a engine
// recusa load_image antes de a janela existir.
func load() -> void
    sheet = game.load_image("images/shooter_sheet.png")
    esheet = game.load_image("images/enemies_sheet.png")
    background = game.load_image("images/background.jpg")
end

// toggle_obstacles liga e desliga o overlay dos retangulos de colisao, para
// conferir o tracado do mapa jogando.
func toggle_obstacles() -> void
    show_obstacles = !show_obstacles
end

func kind_color(k: int) -> game.Color
    if k == 1 then
        return game.rgb(255, 160, 40)
    end
    if k == 2 then
        return game.rgb(180, 100, 255)
    end
    return game.rgb(255, 70, 90)
end

// camera_base e a camera de verdade: centrada no jogador e travada na arena.
// deadrail.nx usa esta para converter o mouse em coordenadas de mundo.
func camera_base(w: wld.World) -> vec.V
    let cx: float = w.player.pos.x - wld.VIEW_W / 2.0
    let cy: float = w.player.pos.y - wld.VIEW_H / 2.0
    if cx < 0.0 then
        cx = 0.0
    end
    if cy < 0.0 then
        cy = 0.0
    end
    if cx > wld.ARENA_W - wld.VIEW_W then
        cx = wld.ARENA_W - wld.VIEW_W
    end
    if cy > wld.ARENA_H - wld.VIEW_H then
        cy = wld.ARENA_H - wld.VIEW_H
    end
    return vec.V(cx, cy)
end

// camera_shaken e so para desenhar. Se a mira usasse esta, o tiro tremeria
// junto com a tela.
func camera_shaken(w: wld.World) -> vec.V
    let c: vec.V = camera_base(w)
    if w.shake <= 0.0 then
        return c
    end
    return vec.V(c.x + rng.rand_float(-w.shake, w.shake), c.y + rng.rand_float(-w.shake, w.shake))
end

// draw_obstacles desenha so os retangulos que caem na tela.
func draw_obstacles(w: wld.World, cam: vec.V) -> void
    for i in range(length(w.obstacles) / 4) do
        let x: float = w.obstacles[i * 4]
        let y: float = w.obstacles[i * 4 + 1]
        let rw: float = w.obstacles[i * 4 + 2]
        let rh: float = w.obstacles[i * 4 + 3]
        if game.rect_overlaps(x, y, rw, rh, cam.x, cam.y, wld.VIEW_W, wld.VIEW_H) then
            game.draw_rect(x, y, rw, rh, OBSTACLE_FILL)
            game.draw_rect_outline(x, y, rw, rh, OBSTACLE_LINE, 2.0)
        end
    end
end

// draw_player centra a celula da sheet na posicao do jogador; o corpo esta
// centrado na celula, entao o circulo de colisao fica no tronco.
func draw_player(w: wld.World) -> void
    let p: anim.Pose = anim.pose(w)
    if !p.visible then
        return
    end
    let sx: float = to_float(p.col) * anim.CELL_W
    let sy: float = to_float(p.row) * anim.CELL_H
    let x: float = w.player.pos.x - anim.CELL_W * PLAYER_SCALE / 2.0
    let y: float = w.player.pos.y - anim.CELL_H * PLAYER_SCALE / 2.0
    game.draw_image_sub_ex(sheet, sx, sy, anim.CELL_W, anim.CELL_H, x, y, PLAYER_SCALE, 0.0, 1.0, p.flip)
end

// draw_enemy: a celula do kind, centrada na posicao e escalada por tipo.
func draw_enemy(e: wld.Enemy, t: float) -> void
    let p: anim.Pose = anim.enemy_pose(e, t)
    if !p.visible then
        return
    end
    let sc: float = anim.enemy_scale(e.kind)
    let sx: float = to_float(p.col) * anim.CELL_W
    let sy: float = to_float(p.row) * anim.CELL_H
    let x: float = e.pos.x - anim.CELL_W * sc / 2.0
    let y: float = e.pos.y - anim.CELL_H * sc / 2.0
    game.draw_image_sub_ex(esheet, sx, sy, anim.CELL_W, anim.CELL_H, x, y, sc, 0.0, 1.0, p.flip)
end

func world(w: wld.World) -> void
    game.clear(BG)
    let cam: vec.V = camera_shaken(w)
    game.camera_set(cam.x, cam.y)

    game.draw_image(background, 0.0, 0.0)

    for i in range(length(w.particles)) do
        let pt: wld.Particle = w.particles[i]
        let a: float = pt.life / pt.life_max
        let base: game.Color = kind_color(pt.color)
        game.draw_circle(pt.pos.x, pt.pos.y, 3.0 * a + 1.0, game.rgba(base.r, base.g, base.b, to_int(220.0 * a)))
    end

    for i in range(length(w.bullets)) do
        let b: wld.Bullet = w.bullets[i]
        game.draw_line(b.pos.x, b.pos.y, b.pos.x - b.vel.x * 0.02, b.pos.y - b.vel.y * 0.02, BULLET_C, 3.0)
    end

    for i in range(length(w.enemies)) do
        draw_enemy(w.enemies[i], w.time)
    end

    draw_player(w)
    if show_obstacles then
        draw_obstacles(w, cam)
    end
    game.camera_reset()
end

let DIM: game.Color = game.rgba(0, 0, 0, 190)
let INK: game.Color = game.rgb(230, 236, 255)
let FADE: game.Color = game.rgb(150, 160, 190)
let GOOD: game.Color = game.rgb(120, 240, 180)
let BAD: game.Color = game.rgb(255, 90, 110)

func centered(s: string, y: float, size: int, c: game.Color) -> void
    let wpx: float = game.text_width(s, size)
    game.draw_text(s, (wld.VIEW_W - wpx) / 2.0, y, size, c)
end

func draw_hud(w: wld.World) -> void
    let frac: float = w.player.hp / w.player.hp_max
    if frac < 0.0 then
        frac = 0.0
    end
    game.draw_rect(16.0, 16.0, 240.0, 18.0, game.rgba(0, 0, 0, 150))
    game.draw_rect(16.0, 16.0, 240.0 * frac, 18.0, game.rgb(90, 230, 130))
    game.draw_rect_outline(16.0, 16.0, 240.0, 18.0, WALL, 2.0)
    game.draw_text(f"{to_int(w.player.hp)} / {to_int(w.player.hp_max)}", 22.0, 17.0, 14, game.BLACK)

    game.draw_text(f"Onda {w.wave} / {waves.TOTAL}", 16.0, 44.0, 18, INK)
    game.draw_text(f"Abates {w.kills}", 16.0, 68.0, 16, FADE)
    game.draw_text(f"Tempo {to_int(w.time)}s", 16.0, 88.0, 16, FADE)

    let restam: int = w.to_spawn + length(w.enemies)
    game.draw_text(f"Restam {restam}", wld.VIEW_W - 120.0, 16.0, 16, FADE)
end

func draw_upgrade(w: wld.World) -> void
    game.draw_rect(0.0, 0.0, wld.VIEW_W, wld.VIEW_H, DIM)
    centered(f"Onda {w.wave} limpa", 120.0, 34, GOOD)
    centered("Escolha um upgrade", 166.0, 20, INK)
    for i in range(length(w.offers)) do
        let idx: int = w.offers[i]
        let y: float = 230.0 + to_float(i) * 84.0
        game.draw_rect(160.0, y, 640.0, 68.0, game.rgba(255, 255, 255, 18))
        game.draw_rect_outline(160.0, y, 640.0, 68.0, WALL, 2.0)
        game.draw_text(f"{i + 1}", 180.0, y + 18.0, 30, GOOD)
        game.draw_text(up.name(idx), 224.0, y + 12.0, 22, INK)
        game.draw_text(up.describe(idx), 224.0, y + 40.0, 16, FADE)
    end
    centered("1, 2 ou 3 para escolher", wld.VIEW_H - 56.0, 16, FADE)
end

func draw_end(w: wld.World) -> void
    game.draw_rect(0.0, 0.0, wld.VIEW_W, wld.VIEW_H, DIM)
    if w.screen == 3 then
        centered("Vitoria", 190.0, 48, GOOD)
        centered("As oito ondas cairam", 252.0, 20, INK)
    else
        centered("Voce morreu", 190.0, 48, BAD)
        centered(f"na onda {w.wave} de {waves.TOTAL}", 252.0, 20, INK)
    end
    centered(f"{w.kills} abates em {to_int(w.time)} segundos", 300.0, 20, FADE)
    centered("R para jogar de novo    Escape para sair", 380.0, 18, FADE)
end

func frame(w: wld.World) -> void
    world(w)
    draw_hud(w)
    if w.screen == 1 then
        draw_upgrade(w)
    elif w.screen >= 2 then
        draw_end(w)
    end
end
