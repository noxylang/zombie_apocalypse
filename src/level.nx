// src/level.nx — o mapa: os obstaculos de images/background.jpg como
// retangulos (x, y, largura, altura, em pixels do mapa), lidos e escritos em
// data/obstacles.txt, e a geometria de colisao. Nao conhece a engine. O
// ponto de partida mora em world.START.
use io
use strings
use src.vec as vec
use src.world as wld

// PATH: um retangulo por linha, "x y w h" em pixels inteiros; linhas vazias
// e as que comecam com # sao ignoradas. Quem escreve e editor.nx (arraste
// sobre o mapa); F1 no jogo mostra os retangulos. Entram predios, galpoes,
// vagoes, conteineres, veiculos, muros e silos. Ficam de fora, de proposito:
// cercas e portoes (os inimigos so deslizam em parede, e um patio cercado
// viraria armadilha), a tubulacao elevada, e miudezas como caixotes, barris,
// pneus e paletes.
let PATH = "data/obstacles.txt"

// Loaded e o resultado de parse/load. Com ok falso, error diz a linha ou o
// caminho e rects vem vazio: carregar meio mapa e salvar por cima perderia
// retangulos, entao quem carrega deve parar.
struct Loaded
    rects: float[],
    ok: bool,
    error: string
end

// parse_line le "x y w h" (espacos e tabs a mais nao importam) e devolve os
// quatro numeros, ou um array vazio se a linha nao tem exatamente quatro
// inteiros nao negativos com largura e altura positivas.
func parse_line(s: string) -> float[]
    let nums: float[] = []
    let none: float[] = []
    let tok: string = ""
    for i in range(length(s) + 1) do
        let ch: string = " "
        if i < length(s) then
            ch = s[i]
        end
        if ch == " " || ch == "\t" || ch == "\r" then
            if length(tok) > 0 then
                if !strings.is_digit(tok) then
                    return none
                end
                append(ref nums, to_float(to_int(tok)))
                tok = ""
            end
        else
            tok = tok + ch
        end
    end
    if length(nums) != 4 || nums[2] <= 0.0 || nums[3] <= 0.0 then
        return none
    end
    return nums
end

// first_char: o primeiro caractere que nao e espaco, ou "" numa linha vazia.
func first_char(s: string) -> string
    for i in range(length(s)) do
        let ch: string = s[i]
        if ch != " " && ch != "\t" && ch != "\r" then
            return ch
        end
    end
    return ""
end

// parse monta os retangulos a partir das linhas do arquivo; a primeira
// linha malformada encerra com erro.
func parse(lines: string[]) -> Loaded
    let rects: float[] = []
    let empty: float[] = []
    for i in range(length(lines)) do
        let s: string = lines[i]
        let first: string = first_char(s)
        if first == "" || first == "#" then
            continue
        end
        let r: float[] = parse_line(s)
        if length(r) == 0 then
            return Loaded(empty, false, f"linha {i + 1}: esperava x y w h inteiros com lados positivos, veio: {s}")
        end
        for k in range(4) do
            append(ref rects, r[k])
        end
    end
    return Loaded(rects, true, "")
end

// parse_text: o mesmo sobre o conteudo inteiro; format e parse_text fazem
// ida e volta.
func parse_text(text: string) -> Loaded
    let lines: string[] = []
    let cur: string = ""
    for i in range(length(text)) do
        let ch: string = text[i]
        if ch == "\n" then
            append(ref lines, cur)
            cur = ""
        else
            cur = cur + ch
        end
    end
    if length(cur) > 0 then
        append(ref lines, cur)
    end
    return parse(lines)
end

// format escreve os retangulos como o arquivo: um cabecalho e um por linha.
func format(rects: float[]) -> string
    let out: string = "# obstaculos do mapa: x y w h em pixels de images/background.jpg (editor.nx escreve este arquivo)\n"
    for i in range(length(rects) / 4) do
        out = out + f"{to_int(rects[i * 4])} {to_int(rects[i * 4 + 1])} {to_int(rects[i * 4 + 2])} {to_int(rects[i * 4 + 3])}\n"
    end
    return out
end

// load le o arquivo; ausente ou malformado dao ok falso com o caminho.
func load(path: string) -> Loaded
    let empty: float[] = []
    let f: io.File = io.open(path, "r")
    if !f.open then
        return Loaded(empty, false, f"{path}: nao consegui abrir o mapa")
    end
    let r: io.IOLinesResult = io.read_lines(f)
    io.close(f)
    if !r.ok then
        return Loaded(empty, false, f"{path}: {r.error}")
    end
    let p: Loaded = parse(r.data)
    if !p.ok then
        return Loaded(empty, false, f"{path}: {p.error}")
    end
    return p
end

// save escreve o arquivo inteiro; false se nao deu para abrir.
func save(path: string, rects: float[]) -> bool
    let f: io.File = io.open(path, "w")
    if !f.open then
        return false
    end
    io.write(f, format(rects))
    io.close(f)
    return true
end

// push_out devolve p empurrado para fora de todo retangulo que o circulo de
// raio r toca. Com o centro fora, sai pela normal do ponto mais proximo (o
// que da o deslize ao longo da parede); com o centro dentro, pela face mais
// proxima. Uma passada por quadro basta: o que sobrar sai no quadro seguinte.
func push_out(p: vec.V, r: float, rects: float[]) -> vec.V
    let out: vec.V = p
    for i in range(length(rects) / 4) do
        let rx: float = rects[i * 4]
        let ry: float = rects[i * 4 + 1]
        let rw: float = rects[i * 4 + 2]
        let rh: float = rects[i * 4 + 3]

        let cx: float = out.x
        if cx < rx then
            cx = rx
        end
        if cx > rx + rw then
            cx = rx + rw
        end
        let cy: float = out.y
        if cy < ry then
            cy = ry
        end
        if cy > ry + rh then
            cy = ry + rh
        end

        let dx: float = out.x - cx
        let dy: float = out.y - cy
        let d2: float = dx * dx + dy * dy
        if d2 >= r * r then
            continue
        end
        if d2 > vec.EPS then
            let d: float = vec.sqrt(d2)
            let push: float = r - d
            out = vec.V(out.x + dx / d * push, out.y + dy / d * push)
            continue
        end

        let left: float = out.x - rx
        let right: float = rx + rw - out.x
        let top: float = out.y - ry
        let bottom: float = ry + rh - out.y
        let m: float = left
        if right < m then
            m = right
        end
        if top < m then
            m = top
        end
        if bottom < m then
            m = bottom
        end
        if m == left then
            out = vec.V(rx - r, out.y)
        elif m == right then
            out = vec.V(rx + rw + r, out.y)
        elif m == top then
            out = vec.V(out.x, ry - r)
        else
            out = vec.V(out.x, ry + rh + r)
        end
    end
    return out
end

// inside: o ponto esta dentro de algum retangulo (balas).
func inside(p: vec.V, rects: float[]) -> bool
    for i in range(length(rects) / 4) do
        let rx: float = rects[i * 4]
        let ry: float = rects[i * 4 + 1]
        if p.x >= rx && p.x <= rx + rects[i * 4 + 2] && p.y >= ry && p.y <= ry + rects[i * 4 + 3] then
            return true
        end
    end
    return false
end

// free: o circulo de raio r em p nao toca retangulo nenhum (spawn).
func free(p: vec.V, r: float, rects: float[]) -> bool
    let q: vec.V = push_out(p, r, rects)
    return q.x == p.x && q.y == p.y
end
