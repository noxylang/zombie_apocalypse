// src/waves.nx — quantos inimigos, de que tipo e por onde entram. Os numeros
// de cada tipo moram em combat.make_enemy; aqui so se escolhe kind e posicao.
use src.vec as vec
use src.world as wld
use src.rng as rng
use src.combat as combat
use src.level as level

let TOTAL = 20
let SPAWN_GAP = 0.35
let MAX_ALIVE = 60          // teto em campo: a separacao entre inimigos e O(n^2), e 120 ja passa dos 16 ms por quadro
let MARGIN = 40.0

// wave_size cresce um pouco mais que linear: 7 na onda 1, 36 na 8, 114 na 20.
func wave_size(n: int) -> int
    return 4 + 3 * n + n * n / 8
end

func start_wave(w: ref wld.World, n: int) -> void
    w.wave = n
    w.to_spawn = wave_size(n)
    w.spawn_cd = 0.0
end

// tank_share: a porcentagem de tanks na onda n. Zero antes da 4; da 4 em
// diante sobe dois pontos por onda, de 25 ate o teto de 45 (onda 14).
func tank_share(n: int) -> int
    if n < 4 then
        return 0
    end
    let s: int = 25 + 2 * (n - 4)
    if s > 45 then
        return 45
    end
    return s
end

// pick_kind abre o leque conforme a onda: chasers sozinhos na 1, rushers da 2
// em diante, tanks da 4 com a fatia de tank_share; rushers ficam em 30% e os
// chasers levam o resto, que encolhe.
func pick_kind(n: int) -> int
    if n <= 1 then
        return 0
    end
    let r: int = rng.rand_int(0, 99)
    if n <= 3 then
        if r < 60 then
            return 0
        end
        return 1
    end
    let tank: int = tank_share(n)
    if r < tank then
        return 2
    end
    if r < tank + 30 then
        return 1
    end
    return 0
end

// edge_point sorteia um dos quatro lados e um ponto nele, recuado pela margem
// para o inimigo nascer dentro da arena.
func edge_point() -> vec.V
    let side: int = rng.rand_int(0, 3)
    if side == 0 then
        return vec.V(rng.rand_float(MARGIN, wld.ARENA_W - MARGIN), MARGIN)
    end
    if side == 1 then
        return vec.V(wld.ARENA_W - MARGIN, rng.rand_float(MARGIN, wld.ARENA_H - MARGIN))
    end
    if side == 2 then
        return vec.V(rng.rand_float(MARGIN, wld.ARENA_W - MARGIN), wld.ARENA_H - MARGIN)
    end
    return vec.V(MARGIN, rng.rand_float(MARGIN, wld.ARENA_H - MARGIN))
end

// spawn_point e edge_point que evita nascer dentro de obstaculo: re-sorteia
// ate cair em ponto livre para o maior inimigo. Se nem assim, o push_out do
// quadro seguinte poe o inimigo para fora.
let SPAWN_TRIES = 12
let SPAWN_CLEAR = 24.0

func spawn_point(w: wld.World) -> vec.V
    let p: vec.V = edge_point()
    for i in range(SPAWN_TRIES) do
        if level.free(p, SPAWN_CLEAR, w.obstacles) then
            return p
        end
        p = edge_point()
    end
    return p
end

func update(w: ref wld.World, dt: float) -> void
    if w.to_spawn <= 0 then
        return
    end
    w.spawn_cd = w.spawn_cd - dt
    if w.spawn_cd > 0.0 then
        return
    end
    // campo cheio: o proximo espera uma vaga, com o intervalo ja vencido
    if length(w.enemies) >= MAX_ALIVE then
        return
    end
    w.spawn_cd = SPAWN_GAP
    append(ref w.enemies, combat.make_enemy(pick_kind(w.wave), spawn_point(*w)))
    w.to_spawn = w.to_spawn - 1
end

func done(w: ref wld.World) -> bool
    return w.to_spawn <= 0 && length(w.enemies) == 0
end
