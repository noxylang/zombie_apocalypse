// src/vec.nx — algebra vetorial. Direcao e sempre vetor unitario; giro de 90
// graus e perp(); comprimento vem de math.hypot.
use math

struct V
    x: float,
    y: float
end

let EPS = 0.000001

func add(a: V, b: V) -> V
    return V(a.x + b.x, a.y + b.y)
end

func sub(a: V, b: V) -> V
    return V(a.x - b.x, a.y - b.y)
end

func scale(a: V, k: float) -> V
    return V(a.x * k, a.y * k)
end

func len(a: V) -> float
    return math.hypot(a.x, a.y)
end

func norm(a: V) -> V
    let l = len(a)
    if l < EPS then
        return V(0.0, 0.0)
    end
    return V(a.x / l, a.y / l)
end

// perp gira 90 graus no sentido horario na tela (y cresce para baixo).
func perp(a: V) -> V
    return V(-a.y, a.x)
end

func dist(a: V, b: V) -> float
    return len(sub(a, b))
end
