//     noxy tests/run.nx      (a partir da raiz do projeto)
use sys
use math
use src.vec as vec
use src.rng as rng
use src.world as wld
use src.combat as combat
use src.waves as waves
use src.upgrades as up
use src.flow as flow
use src.anim as anim
use src.level as level
use src.editor as editor
use io
use strings

let fails = 0
let total = 0

func check(name: string, cond: bool) -> void
    total = total + 1
    if cond then
        print(f"  ok   {name}")
    else
        print(f"FAIL   {name}")
        fails = fails + 1
    end
end

func near(a: float, b: float, tol: float) -> bool
    let d = a - b
    if d < 0.0 then
        d = -d
    end
    return d <= tol
end

func report() -> void
    print("")
    print(f"{total - fails}/{total} passaram")
    if fails > 0 then
        sys.exit(1)
    end
end

func test_vec() -> void
    print("vec")
    let n: vec.V = vec.norm(vec.V(3.0, 4.0))
    check("norm(3,4).x = 0.6", near(n.x, 0.6, 0.0001))
    check("norm(3,4).y = 0.8", near(n.y, 0.8, 0.0001))

    let z: vec.V = vec.norm(vec.V(0.0, 0.0))
    check("norm do vetor zero nao divide por zero", z.x == 0.0 && z.y == 0.0)

    let p: vec.V = vec.perp(vec.V(2.0, 5.0))
    check("perp e ortogonal", near(p.x * 2.0 + p.y * 5.0, 0.0, 0.0001))
    check("perp preserva o comprimento", near(vec.len(p), vec.len(vec.V(2.0, 5.0)), 0.0001))

    check("len(3,4) = 5", near(vec.len(vec.V(3.0, 4.0)), 5.0, 0.0001))
    check("dist((1,1),(4,5)) = 5", near(vec.dist(vec.V(1.0, 1.0), vec.V(4.0, 5.0)), 5.0, 0.0001))

    let s: vec.V = vec.scale(vec.V(2.0, -3.0), 2.5)
    check("scale multiplica os dois eixos", s.x == 5.0 && s.y == -7.5)

    let a: vec.V = vec.add(vec.V(1.0, 2.0), vec.V(10.0, 20.0))
    check("add soma", a.x == 11.0 && a.y == 22.0)

    let b: vec.V = vec.sub(vec.V(10.0, 20.0), vec.V(1.0, 2.0))
    check("sub subtrai", b.x == 9.0 && b.y == 18.0)
end

func test_rng() -> void
    print("rng")
    let fora = 0
    let viu_lo = false
    let viu_hi = false
    for i in range(1000) do
        let v: int = rng.rand_int(3, 7)
        if v < 3 || v > 7 then
            fora = fora + 1
        end
        if v == 3 then
            viu_lo = true
        end
        if v == 7 then
            viu_hi = true
        end
    end
    check("rand_int fica no intervalo em 1000 sorteios", fora == 0)
    check("rand_int alcanca o limite inferior", viu_lo)
    check("rand_int alcanca o limite superior (inclusivo)", viu_hi)
    check("rand_int com lo == hi devolve lo", rng.rand_int(4, 4) == 4)
    check("rand_int com hi < lo devolve lo", rng.rand_int(9, 2) == 9)

    let ffora = 0
    for i in range(500) do
        let f: float = rng.rand_float(-2.0, 5.0)
        if f < -2.0 || f > 5.0 then
            ffora = ffora + 1
        end
    end
    check("rand_float fica no intervalo", ffora == 0)

    let mau = 0
    for i in range(200) do
        let d: vec.V = rng.rand_dir()
        if !near(vec.len(d), 1.0, 0.0001) then
            mau = mau + 1
        end
    end
    check("rand_dir e sempre unitario", mau == 0)
end

func test_world() -> void
    print("world")
    let w: wld.World = wld.new_world()
    check("jogador comeca no ponto de partida do mapa", w.player.pos.x == wld.START.x && w.player.pos.y == wld.START.y)
    check("o ponto de partida esta dentro da arena", wld.START.x > 0.0 && wld.START.x < wld.ARENA_W && wld.START.y > 0.0 && wld.START.y < wld.ARENA_H)
    check("mundo novo nao tem obstaculos", length(w.obstacles) == 0)
    check("vida cheia", w.player.hp == 100.0 && w.player.hp_max == 100.0)
    check("um tiro por vez no comeco", w.player.shots == 1)
    check("sem perfuracao no comeco", w.player.pierce == 0)
    check("pronto para atirar", w.player.fire_cd == 0.0)
    check("sem invencibilidade no comeco", w.player.invuln == 0.0)
    check("mira inicial nao e o vetor zero", vec.len(w.player.aim) > 0.5)
    check("mundo comeca vazio", length(w.enemies) == 0 && length(w.bullets) == 0 && length(w.particles) == 0)
    check("comeca na tela de jogo", w.screen == 0)
    check("placar zerado", w.kills == 0 && w.wave == 0 && w.time == 0.0)
    check("arena e maior que a janela", wld.ARENA_W > wld.VIEW_W && wld.ARENA_H > wld.VIEW_H)

    let a: wld.World = wld.new_world()
    let b: wld.World = wld.new_world()
    append(ref a.enemies, wld.Enemy(vec.V(0.0, 0.0), vec.V(0.0, 0.0), 0, 1.0, 1.0, 1.0, 1.0, 0.0, 0.0))
    check("mundos novos sao independentes", length(b.enemies) == 0)
end

func test_move() -> void
    print("combat: movimento")
    let w: wld.World = wld.new_world()
    let x0 = w.player.pos.x
    combat.move_player(ref w, vec.V(1.0, 0.0), vec.V(1.0, 0.0), 1.0)
    check("anda a speed px por segundo", near(w.player.pos.x, x0 + 220.0, 0.001))

    let d: wld.World = wld.new_world()
    combat.move_player(ref d, vec.V(1.0, 1.0), vec.V(1.0, 0.0), 1.0)
    let andou: float = vec.dist(d.player.pos, wld.START)
    check("diagonal anda o mesmo que a reta", near(andou, 220.0, 0.001))

    let s: wld.World = wld.new_world()
    combat.move_player(ref s, vec.V(0.0, 0.0), vec.V(1.0, 0.0), 1.0)
    check("sem input nao anda", s.player.pos.x == wld.START.x && s.player.pos.y == wld.START.y)

    let p: wld.World = wld.new_world()
    for i in range(60) do
        combat.move_player(ref p, vec.V(-1.0, -1.0), vec.V(1.0, 0.0), 1.0)
    end
    check("nao sai pela borda esquerda", p.player.pos.x >= wld.PLAYER_R)
    check("nao sai pela borda de cima", p.player.pos.y >= wld.PLAYER_R)
    for i in range(120) do
        combat.move_player(ref p, vec.V(1.0, 1.0), vec.V(1.0, 0.0), 1.0)
    end
    check("nao sai pela borda direita", p.player.pos.x <= wld.ARENA_W - wld.PLAYER_R)
    check("nao sai pela borda de baixo", p.player.pos.y <= wld.ARENA_H - wld.PLAYER_R)

    let m: wld.World = wld.new_world()
    combat.move_player(ref m, vec.V(0.0, 0.0), vec.V(0.0, 30.0), 0.016)
    check("mira normaliza", near(vec.len(m.player.aim), 1.0, 0.0001))
    check("mira aponta para o alvo", near(m.player.aim.y, 1.0, 0.0001))
    combat.move_player(ref m, vec.V(0.0, 0.0), vec.V(0.0, 0.0), 0.016)
    check("mira nula preserva a anterior", near(m.player.aim.y, 1.0, 0.0001))

    let t: wld.World = wld.new_world()
    t.player.fire_cd = 0.5
    t.player.invuln = 0.5
    t.shake = 10.0
    combat.move_player(ref t, vec.V(0.0, 0.0), vec.V(1.0, 0.0), 0.25)
    check("fire_cd decai com dt", near(t.player.fire_cd, 0.25, 0.0001))
    check("invuln decai com dt", near(t.player.invuln, 0.25, 0.0001))
    check("tempo de partida acumula", near(t.time, 0.25, 0.0001))
    check("tremida decai", t.shake < 10.0)
    combat.move_player(ref t, vec.V(0.0, 0.0), vec.V(1.0, 0.0), 5.0)
    check("fire_cd nao fica negativo", t.player.fire_cd >= 0.0)
    check("invuln nao fica negativo", t.player.invuln >= 0.0)

    let mv: wld.World = wld.new_world()
    combat.move_player(ref mv, vec.V(3.0, 0.0), vec.V(1.0, 0.0), 0.016)
    check("andar guarda a direcao do passo, unitaria", mv.player.move.x == 1.0 && mv.player.move.y == 0.0)
    combat.move_player(ref mv, vec.V(0.0, 0.0), vec.V(1.0, 0.0), 0.016)
    check("parar zera o passo", mv.player.move.x == 0.0 && mv.player.move.y == 0.0)
    check("tremida nao fica negativa", t.shake >= 0.0)
end

func test_fire() -> void
    print("combat: tiro")
    let w: wld.World = wld.new_world()
    w.player.aim = vec.V(1.0, 0.0)
    combat.fire(ref w)
    check("um tiro sai uma bala", length(w.bullets) == 1)
    check("a bala herda o dano do jogador", w.bullets[0].damage == 10.0)
    check("a bala sai a bullet_speed", near(vec.len(w.bullets[0].vel), 600.0, 0.001))
    check("a bala nasce a frente do jogador", w.bullets[0].pos.x > w.player.pos.x)
    check("a bala nasce sem acertos", w.bullets[0].hits == 0)
    check("atirar poe a arma em recarga", near(w.player.fire_cd, 0.2, 0.0001))

    combat.fire(ref w)
    check("nao atira durante a recarga", length(w.bullets) == 1)

    w.player.fire_cd = 0.0
    combat.fire(ref w)
    check("atira de novo quando a recarga acaba", length(w.bullets) == 2)

    let l: wld.World = wld.new_world()
    l.player.aim = vec.V(1.0, 0.0)
    l.player.shots = 3
    combat.fire(ref l)
    check("leque sai com tres balas", length(l.bullets) == 3)
    check("a bala do meio segue a mira", near(l.bullets[0].vel.y, 0.0, 0.001))
    check("as laterais abrem para os dois lados", l.bullets[1].vel.y * l.bullets[2].vel.y < 0.0)
    check("as tres saem na mesma velocidade", near(vec.len(l.bullets[1].vel), 600.0, 0.001) && near(vec.len(l.bullets[2].vel), 600.0, 0.001))
    check("as laterais abrem 12 graus", near(l.bullets[1].vel.x / 600.0, math.cos(12.0 * math.PI / 180.0), 0.0001) && near(l.bullets[2].vel.x, l.bullets[1].vel.x, 0.0001))

    let c: wld.World = wld.new_world()
    c.player.aim = vec.V(1.0, 0.0)
    c.player.fire_rate = 10.0
    combat.fire(ref c)
    check("cadencia maior encurta a recarga", near(c.player.fire_cd, 0.1, 0.0001))

    let m: wld.World = wld.new_world()
    m.player.aim = vec.V(1.0, 0.0)
    combat.fire(ref m)
    let x0 = m.bullets[0].pos.x
    combat.move_bullets(ref m, 0.1)
    check("a bala anda vel * dt", near(m.bullets[0].pos.x, x0 + 60.0, 0.001))
    check("a bala envelhece", near(m.bullets[0].life, 1.1, 0.0001))

    m.bullets[0].life = 0.05
    combat.move_bullets(ref m, 0.1)
    check("a bala expira zerando a vida", m.bullets[0].life <= 0.0)
    check("move_bullets nao remove nada", length(m.bullets) == 1)

    let o: wld.World = wld.new_world()
    o.player.aim = vec.V(1.0, 0.0)
    combat.fire(ref o)
    o.bullets[0].pos.x = wld.ARENA_W + 5.0
    combat.move_bullets(ref o, 0.016)
    check("bala fora da arena morre", o.bullets[0].life <= 0.0)
end

func test_enemies() -> void
    print("combat: inimigos")
    let w: wld.World = wld.new_world()
    let alvo: vec.V = w.player.pos

    let c: wld.Enemy = combat.make_enemy(0, vec.V(10.0, 10.0))
    check("chaser tem 20 de vida", c.hp == 20.0)
    check("chaser anda a 90", c.speed == 90.0)
    let r: wld.Enemy = combat.make_enemy(1, vec.V(10.0, 10.0))
    check("rusher e rapido e fragil", r.speed == 170.0 && r.hp == 10.0)
    let t: wld.Enemy = combat.make_enemy(2, vec.V(10.0, 10.0))
    check("tank e lento e duro", t.speed == 55.0 && t.hp == 60.0)
    check("tank machuca mais no contato", t.touch > c.touch)
    check("kind desconhecido vira chaser", combat.make_enemy(99, vec.V(0.0, 0.0)).kind == 0)

    append(ref w.enemies, combat.make_enemy(0, vec.V(alvo.x - 400.0, alvo.y)))
    let antes: float = vec.dist(w.enemies[0].pos, alvo)
    combat.update_enemies(ref w, 1.0)
    let depois: float = vec.dist(w.enemies[0].pos, alvo)
    check("o inimigo se aproxima do jogador", depois < antes)
    check("anda speed * dt", near(antes - depois, 90.0, 0.01))

    w.enemies[0].flash = 0.1
    combat.update_enemies(ref w, 0.05)
    check("o flash de acerto decai", near(w.enemies[0].flash, 0.05, 0.0001))
    combat.update_enemies(ref w, 1.0)
    check("o flash nao fica negativo", w.enemies[0].flash >= 0.0)

    let s: wld.World = wld.new_world()
    append(ref s.enemies, combat.make_enemy(0, vec.V(300.0, 300.0)))
    append(ref s.enemies, combat.make_enemy(0, vec.V(302.0, 300.0)))
    combat.update_enemies(ref s, 0.016)
    check("inimigos sobrepostos se separam", vec.dist(s.enemies[0].pos, s.enemies[1].pos) > 2.0)

    let k: wld.World = wld.new_world()
    append(ref k.enemies, combat.make_enemy(0, vec.V(k.player.pos.x, k.player.pos.y)))
    combat.resolve_contact(ref k)
    check("contato tira vida", k.player.hp == 90.0)
    check("contato liga a invencibilidade", k.player.invuln > 0.0)
    check("contato sacode a tela", k.shake > 0.0)

    let hp1 = k.player.hp
    combat.resolve_contact(ref k)
    check("invencibilidade impede dano em sequencia", k.player.hp == hp1)

    let m: wld.World = wld.new_world()
    m.player.hp = 5.0
    append(ref m.enemies, combat.make_enemy(0, vec.V(m.player.pos.x, m.player.pos.y)))
    combat.resolve_contact(ref m)
    check("vida nao fica negativa", m.player.hp == 0.0)
    check("morrer leva a tela de game over", m.screen == 2)
end

func test_hits() -> void
    print("combat: acertos e mortes")
    let w: wld.World = wld.new_world()
    append(ref w.enemies, combat.make_enemy(0, vec.V(500.0, 500.0)))
    append(ref w.bullets, wld.Bullet(vec.V(500.0, 500.0), vec.V(600.0, 0.0), 1.0, 10.0, 0))
    combat.resolve_hits(ref w)
    check("a bala tira o dano da vida do inimigo", w.enemies[0].hp == 10.0)
    check("o inimigo atingido pisca", w.enemies[0].flash > 0.0)
    check("a bala sem perfuracao morre no acerto", w.bullets[0].life <= 0.0)

    let f: wld.World = wld.new_world()
    append(ref f.enemies, combat.make_enemy(0, vec.V(500.0, 500.0)))
    append(ref f.bullets, wld.Bullet(vec.V(900.0, 500.0), vec.V(600.0, 0.0), 1.0, 10.0, 0))
    combat.resolve_hits(ref f)
    check("bala longe nao acerta", f.enemies[0].hp == 20.0 && f.bullets[0].life > 0.0)

    let p: wld.World = wld.new_world()
    p.player.pierce = 1
    append(ref p.enemies, combat.make_enemy(0, vec.V(500.0, 500.0)))
    append(ref p.enemies, combat.make_enemy(0, vec.V(500.0, 506.0)))
    append(ref p.bullets, wld.Bullet(vec.V(500.0, 503.0), vec.V(600.0, 0.0), 1.0, 10.0, 0))
    combat.resolve_hits(ref p)
    check("com perfuracao a bala acerta os dois", p.enemies[0].hp == 10.0 && p.enemies[1].hp == 10.0)
    check("mas morre no segundo", p.bullets[0].life <= 0.0)

    let k: wld.World = wld.new_world()
    append(ref k.enemies, combat.make_enemy(0, vec.V(500.0, 500.0)))
    append(ref k.enemies, combat.make_enemy(1, vec.V(700.0, 500.0)))
    append(ref k.bullets, wld.Bullet(vec.V(0.0, 0.0), vec.V(0.0, 0.0), 0.0, 10.0, 0))
    append(ref k.bullets, wld.Bullet(vec.V(0.0, 0.0), vec.V(0.0, 0.0), 1.0, 10.0, 0))
    k.enemies[0].hp = 0.0
    combat.reap(ref k)
    check("inimigo morto sai do array", length(k.enemies) == 1)
    check("o sobrevivente e o certo", k.enemies[0].kind == 1)
    check("a morte conta como abate", k.kills == 1)
    check("a morte gera estilhacos", length(k.particles) == 8)
    check("os estilhacos herdam a cor do tipo", k.particles[0].color == 0)
    check("bala sem vida sai do array", length(k.bullets) == 1)
    check("a bala viva fica", k.bullets[0].life == 1.0)

    let q: wld.World = wld.new_world()
    append(ref q.particles, wld.Particle(vec.V(100.0, 100.0), vec.V(100.0, 0.0), 0.5, 0.5, 0))
    combat.update_particles(ref q, 0.1)
    check("a particula anda", q.particles[0].pos.x > 100.0)
    check("a particula desacelera", vec.len(q.particles[0].vel) < 100.0)
    check("a particula envelhece", near(q.particles[0].life, 0.4, 0.0001))
    combat.update_particles(ref q, 1.0)
    check("a particula morta some", length(q.particles) == 0)

    let s: wld.World = wld.new_world()
    s.player.aim = vec.V(1.0, 0.0)
    append(ref s.enemies, combat.make_enemy(0, vec.V(s.player.pos.x + 300.0, s.player.pos.y)))
    combat.step(ref s, vec.V(0.0, 0.0), vec.V(1.0, 0.0), true, 0.016)
    check("step atirando cria bala", length(s.bullets) == 1)
    check("step move o inimigo", s.enemies[0].pos.x < s.player.pos.x + 300.0)
    check("step conta o tempo", s.time > 0.0)

    let ns: wld.World = wld.new_world()
    combat.step(ref ns, vec.V(0.0, 0.0), vec.V(1.0, 0.0), false, 0.016)
    check("step sem atirar nao cria bala", length(ns.bullets) == 0)
end

func test_waves() -> void
    print("waves")
    check("vinte ondas", waves.TOTAL == 20)
    check("onda 1 tem 7 inimigos", waves.wave_size(1) == 7)
    check("onda 8 tem 36 inimigos", waves.wave_size(8) == 36)
    check("onda 20 tem 114 inimigos", waves.wave_size(20) == 114)
    let cresce = true
    for n in range(1, waves.TOTAL) do
        if waves.wave_size(n + 1) <= waves.wave_size(n) then
            cresce = false
        end
    end
    check("cada onda traz mais inimigos que a anterior", cresce)

    let w: wld.World = wld.new_world()
    waves.start_wave(ref w, 3)
    check("start_wave anota a onda", w.wave == 3)
    check("start_wave enfileira o tamanho certo", w.to_spawn == waves.wave_size(3))
    check("start_wave libera o primeiro spawn na hora", w.spawn_cd <= 0.0)

    let so_chaser = true
    for i in range(200) do
        if waves.pick_kind(1) != 0 then
            so_chaser = false
        end
    end
    check("onda 1 so tem chasers", so_chaser)

    let sem_tank = true
    for i in range(400) do
        if waves.pick_kind(3) == 2 then
            sem_tank = false
        end
    end
    check("tanks so aparecem da onda 4 em diante", sem_tank)

    let viu_rusher = false
    for i in range(400) do
        if waves.pick_kind(3) == 1 then
            viu_rusher = true
        end
    end
    check("rushers aparecem na onda 3", viu_rusher)

    let viu_tank = false
    for i in range(400) do
        if waves.pick_kind(6) == 2 then
            viu_tank = true
        end
    end
    check("tanks aparecem na onda 6", viu_tank)

    check("fatia de tanks: 0 antes da onda 4, 25 na 4, 45 da 14 em diante", waves.tank_share(3) == 0 && waves.tank_share(4) == 25 && waves.tank_share(14) == 45 && waves.tank_share(20) == 45)
    let t4 = 0
    let t20 = 0
    for i in range(2000) do
        if waves.pick_kind(4) == 2 then
            t4 = t4 + 1
        end
        if waves.pick_kind(20) == 2 then
            t20 = t20 + 1
        end
    end
    check("a onda 20 sorteia bem mais tanks que a 4", t20 > t4 + 100)

    let cheio: wld.World = wld.new_world()
    waves.start_wave(ref cheio, 20)
    for i in range(waves.MAX_ALIVE) do
        append(ref cheio.enemies, combat.make_enemy(0, vec.V(100.0 + to_float(i) * 30.0, 100.0)))
    end
    waves.update(ref cheio, 0.016)
    check("com o campo cheio, ninguem mais entra", length(cheio.enemies) == waves.MAX_ALIVE && cheio.to_spawn == waves.wave_size(20))
    pop(ref cheio.enemies)
    waves.update(ref cheio, 0.016)
    check("aberta uma vaga, o proximo entra na hora", length(cheio.enemies) == waves.MAX_ALIVE && cheio.to_spawn == waves.wave_size(20) - 1)

    let fora = 0
    for i in range(300) do
        let pp: vec.V = waves.edge_point()
        if pp.x < 0.0 || pp.x > wld.ARENA_W || pp.y < 0.0 || pp.y > wld.ARENA_H then
            fora = fora + 1
        end
    end
    check("spawn cai dentro da arena", fora == 0)

    let sp: wld.World = wld.new_world()
    waves.start_wave(ref sp, 1)
    waves.update(ref sp, 0.016)
    check("o primeiro inimigo entra logo", length(sp.enemies) == 1)
    check("e sai da fila", sp.to_spawn == waves.wave_size(1) - 1)
    waves.update(ref sp, 0.016)
    check("o segundo espera o intervalo", length(sp.enemies) == 1)
    waves.update(ref sp, 1.0)
    check("passado o intervalo, entra o segundo", length(sp.enemies) == 2)

    let d: wld.World = wld.new_world()
    waves.start_wave(ref d, 1)
    check("onda recem-comecada nao terminou", !waves.done(ref d))
    d.to_spawn = 0
    append(ref d.enemies, combat.make_enemy(0, vec.V(100.0, 100.0)))
    check("com inimigo vivo a onda nao terminou", !waves.done(ref d))
    let vazio: wld.Enemy[] = []
    d.enemies = vazio
    check("fila vazia e campo limpo terminam a onda", waves.done(ref d))

    let f: wld.World = wld.new_world()
    waves.start_wave(ref f, 2)
    for i in range(200) do
        waves.update(ref f, 0.5)
    end
    check("a onda inteira e liberada", f.to_spawn == 0)
    check("e todos entraram em campo", length(f.enemies) == waves.wave_size(2))
end

func test_upgrades() -> void
    print("upgrades")
    check("seis upgrades", up.COUNT == 6)

    let sem_nome = 0
    for i in range(up.COUNT) do
        if length(up.name(i)) == 0 || length(up.describe(i)) == 0 then
            sem_nome = sem_nome + 1
        end
    end
    check("todo upgrade tem nome e descricao", sem_nome == 0)

    let ruim = 0
    for k in range(200) do
        let o: int[] = up.offer()
        if length(o) != 3 then
            ruim = ruim + 1
        elif o[0] == o[1] || o[1] == o[2] || o[0] == o[2] then
            ruim = ruim + 1
        elif o[0] < 0 || o[0] >= up.COUNT || o[1] < 0 || o[1] >= up.COUNT || o[2] < 0 || o[2] >= up.COUNT then
            ruim = ruim + 1
        end
    end
    check("offer da tres indices distintos e validos", ruim == 0)

    let a: wld.World = wld.new_world()
    up.apply(ref a, 0)
    check("cadencia sobe 35%", near(a.player.fire_rate, 6.75, 0.0001))
    check("cadencia nao mexe no dano", a.player.damage == 10.0)

    let b: wld.World = wld.new_world()
    up.apply(ref b, 1)
    check("dano sobe 6", b.player.damage == 16.0)

    let c: wld.World = wld.new_world()
    up.apply(ref c, 2)
    check("botas sobem 15%", near(c.player.speed, 253.0, 0.0001))

    let d: wld.World = wld.new_world()
    d.player.hp = 40.0
    up.apply(ref d, 3)
    check("blindagem sobe o maximo", d.player.hp_max == 130.0)
    check("blindagem cura 30", d.player.hp == 70.0)

    let e: wld.World = wld.new_world()
    up.apply(ref e, 3)
    check("blindagem nao cura acima do maximo", e.player.hp == e.player.hp_max && e.player.hp == 130.0)

    let f: wld.World = wld.new_world()
    up.apply(ref f, 4)
    check("leque liga o tiro triplo", f.player.shots == 3)
    check("leque nao mexe no dano na primeira vez", f.player.damage == 10.0)
    up.apply(ref f, 4)
    check("leque repetido vira dano", f.player.damage == 16.0)
    check("leque repetido nao passa de tres tiros", f.player.shots == 3)

    let g: wld.World = wld.new_world()
    up.apply(ref g, 5)
    check("perfuracao sobe 1", g.player.pierce == 1)
    up.apply(ref g, 5)
    check("perfuracao empilha", g.player.pierce == 2)

    let h: wld.World = wld.new_world()
    up.apply(ref h, 1)
    check("dano nao mexe na velocidade nem na cadencia", h.player.speed == 220.0 && h.player.fire_rate == 5.0)
    check("dano nao mexe na vida", h.player.hp == 100.0 && h.player.hp_max == 100.0)
end

func test_flow() -> void
    print("flow")
    let w: wld.World = wld.new_world()
    flow.begin(ref w)
    check("begin comeca na onda 1 jogando", w.wave == 1 && w.screen == 0)
    check("begin enfileira a onda", w.to_spawn == waves.wave_size(1))

    // limpar uma onda que nao e a ultima leva a tela de upgrade
    w.to_spawn = 0
    let vazio: wld.Enemy[] = []
    w.enemies = vazio
    flow.advance(ref w, vec.V(0.0, 0.0), vec.V(1.0, 0.0), false, -1, false, 0.016)
    check("onda limpa leva a tela de upgrade", w.screen == 1)
    check("a tela de upgrade oferta tres cartas", length(w.offers) == 3)

    // escolha invalida nao faz nada
    let antes_wave = w.wave
    flow.advance(ref w, vec.V(0.0, 0.0), vec.V(1.0, 0.0), false, 7, false, 0.016)
    check("escolha fora do intervalo e ignorada", w.screen == 1 && w.wave == antes_wave)
    flow.advance(ref w, vec.V(0.0, 0.0), vec.V(1.0, 0.0), false, -1, false, 0.016)
    check("sem escolha a tela de upgrade espera", w.screen == 1)

    // escolher avanca a onda
    flow.advance(ref w, vec.V(0.0, 0.0), vec.V(1.0, 0.0), false, 0, false, 0.016)
    check("escolher volta a jogar", w.screen == 0)
    check("escolher comeca a onda seguinte", w.wave == antes_wave + 1)
    check("a onda seguinte vem cheia", w.to_spawn == waves.wave_size(w.wave))

    // limpar a ultima onda e vitoria
    let v: wld.World = wld.new_world()
    flow.begin(ref v)
    v.wave = waves.TOTAL
    v.to_spawn = 0
    let vazio2: wld.Enemy[] = []
    v.enemies = vazio2
    flow.advance(ref v, vec.V(0.0, 0.0), vec.V(1.0, 0.0), false, -1, false, 0.016)
    check("limpar a ultima onda e vitoria", v.screen == 3)
    check("a vitoria nao oferta upgrade", length(v.offers) == 0)

    // reinicio
    let g: wld.World = wld.new_world()
    flow.begin(ref g)
    g.player.hp = 3.0
    g.player.damage = 99.0
    g.player.shots = 3
    g.kills = 42
    g.time = 120.0
    g.wave = 5
    g.screen = 2
    flow.advance(ref g, vec.V(0.0, 0.0), vec.V(1.0, 0.0), false, -1, false, 0.016)
    check("sem pedir, o game over nao reinicia", g.screen == 2 && g.kills == 42)
    flow.advance(ref g, vec.V(0.0, 0.0), vec.V(1.0, 0.0), false, -1, true, 0.016)
    check("reiniciar volta a jogar", g.screen == 0)
    check("reiniciar volta para a onda 1", g.wave == 1)
    check("reiniciar restaura a vida", g.player.hp == 100.0)
    check("reiniciar apaga os upgrades", g.player.damage == 10.0 && g.player.shots == 1)
    check("reiniciar zera o placar", g.kills == 0 && g.time == 0.0)

    let e: wld.World = wld.new_world()
    flow.begin(ref e)
    flow.advance(ref e, vec.V(0.0, 0.0), vec.V(1.0, 0.0), false, -1, false, 0.25)
    check("jogando, since_end fica em zero", e.since_end == 0.0)
    e.screen = 2
    flow.advance(ref e, vec.V(0.0, 0.0), vec.V(1.0, 0.0), false, -1, false, 0.25)
    flow.advance(ref e, vec.V(0.0, 0.0), vec.V(1.0, 0.0), false, -1, false, 0.25)
    check("no game over, since_end acumula", near(e.since_end, 0.5, 0.0001))
    check("no game over, o tempo de partida para", near(e.time, 0.25, 0.0001))
    flow.advance(ref e, vec.V(0.0, 0.0), vec.V(1.0, 0.0), false, -1, true, 0.25)
    check("reiniciar zera since_end", e.since_end == 0.0)
    e.screen = 3
    flow.advance(ref e, vec.V(0.0, 0.0), vec.V(1.0, 0.0), false, -1, false, 0.25)
    check("na vitoria, since_end tambem acumula", near(e.since_end, 0.25, 0.0001))

    // reiniciar nao age enquanto se joga
    let j: wld.World = wld.new_world()
    flow.begin(ref j)
    j.kills = 7
    flow.advance(ref j, vec.V(0.0, 0.0), vec.V(1.0, 0.0), false, -1, true, 0.016)
    check("reiniciar e ignorado durante o jogo", j.kills == 7 && j.screen == 0)
end

// posed monta um mundo no tempo t, mirando em aim e andando em mv (zero para
// parado), para ler a pose.
func posed(aim: vec.V, mv: vec.V, t: float) -> wld.World
    let w: wld.World = wld.new_world()
    w.player.aim = vec.norm(aim)
    w.player.move = vec.norm(mv)
    w.time = t
    return w
end

let STILL: vec.V = vec.V(0.0, 0.0)
let RIGHT: vec.V = vec.V(1.0, 0.0)
let LEFT: vec.V = vec.V(-1.0, 0.0)
let UP: vec.V = vec.V(0.0, -1.0)
let DOWN: vec.V = vec.V(0.0, 1.0)

func test_anim() -> void
    print("anim")
    check("a sheet tem uma contagem de frames por linha", length(anim.FRAMES) == 7)

    let r: anim.Pose = anim.pose(posed(vec.V(1.0, 0.0), STILL, 0.0))
    check("parado mirando a direita usa o idle lateral", r.row == anim.IDLE_SIDE && r.col == 0)
    check("mirando a direita nao espelha", !r.flip)
    check("sem invencibilidade fica visivel", r.visible)

    let l: anim.Pose = anim.pose(posed(vec.V(-1.0, 0.2), STILL, 0.0))
    check("mirando a esquerda espelha", l.flip && l.row == anim.IDLE_SIDE)

    let d: anim.Pose = anim.pose(posed(vec.V(0.0, 1.0), STILL, 0.0))
    check("parado mirando para baixo usa o idle frontal", d.row == anim.IDLE_DOWN && !d.flip)
    let d2: anim.Pose = anim.pose(posed(vec.V(0.0, 1.0), STILL, 0.3))
    check("o idle frontal anima a 4 fps", d2.col == 1)

    let u: anim.Pose = anim.pose(posed(vec.V(0.0, -1.0), STILL, 0.0))
    check("parado mirando para cima usa o frame 0 de andar de costas", u.row == anim.WALK_UP && u.col == 0)

    let diag_s: anim.Pose = anim.pose(posed(vec.V(1.0, 0.5), STILL, 0.0))
    check("diagonal mais horizontal vira de lado", diag_s.row == anim.IDLE_SIDE)
    let diag_d: anim.Pose = anim.pose(posed(vec.V(0.5, 1.0), STILL, 0.0))
    check("diagonal mais vertical vira de frente", diag_d.row == anim.IDLE_DOWN)

    let ws0: anim.Pose = anim.pose(posed(vec.V(1.0, 0.0), vec.V(1.0, 0.0), 0.0))
    let ws1: anim.Pose = anim.pose(posed(vec.V(1.0, 0.0), vec.V(1.0, 0.0), 0.15))
    let volta: float = to_float(anim.FRAMES[anim.WALK_SIDE]) * 0.1 + 0.05
    let wsv: anim.Pose = anim.pose(posed(vec.V(1.0, 0.0), vec.V(1.0, 0.0), volta))
    check("andando de lado usa a linha de andar", ws0.row == anim.WALK_SIDE && ws0.col == 0)
    check("andar avanca o frame a 10 fps", ws1.col == 1)
    check("andar da a volta na linha", wsv.col == 0)
    // a caminhada lateral e montada so com frames de vista lateral (linha 7 da
    // direita): misturar vistas de costas e de frente em 3/4 fazia o soldado
    // parecer girar a cada ciclo.
    check("andar de lado tem 4 frames de vista lateral", anim.FRAMES[anim.WALK_SIDE] == 4)
    check("o idle lateral e um frame so", anim.FRAMES[anim.IDLE_SIDE] == 1)
    check("andando para baixo usa a linha frontal", anim.pose(posed(vec.V(0.0, 1.0), vec.V(0.0, 1.0), 0.0)).row == anim.WALK_DOWN)
    check("andando para cima usa a linha de costas", anim.pose(posed(vec.V(0.0, -1.0), vec.V(0.0, -1.0), 0.0)).row == anim.WALK_UP)

    let sh: wld.World = posed(vec.V(1.0, 0.0), vec.V(1.0, 0.0), 0.0)
    sh.player.fire_cd = 0.1
    check("atirando de lado usa a linha de tiro, mesmo andando", anim.pose(sh).row == anim.SHOOT_SIDE)
    let sh2: wld.World = posed(vec.V(-1.0, 0.0), STILL, 0.2)
    sh2.player.fire_cd = 0.1
    let p2: anim.Pose = anim.pose(sh2)
    check("tiro anima a 15 fps e espelha para a esquerda", p2.col == 3 && p2.flip)
    let shd: wld.World = posed(vec.V(0.0, 1.0), STILL, 0.0)
    shd.player.fire_cd = 0.1
    check("atirando para baixo nao ha linha de tiro: fica de frente", anim.pose(shd).row == anim.IDLE_DOWN)

    let b0: wld.World = posed(vec.V(1.0, 0.0), STILL, 0.0)
    b0.player.invuln = 0.5
    check("invencivel no instante 0 fica visivel", anim.pose(b0).visible)
    let b1: wld.World = posed(vec.V(1.0, 0.0), STILL, 0.07)
    b1.player.invuln = 0.5
    check("invencivel pisca: apagado em 0.07s", !anim.pose(b1).visible)

    let m: wld.World = posed(vec.V(-1.0, 0.0), vec.V(-1.0, 0.0), 9.0)
    m.screen = 2
    m.player.invuln = 0.5
    m.player.fire_cd = 0.1
    m.since_end = 0.0
    let m0: anim.Pose = anim.pose(m)
    check("morto usa a linha de morte desde o frame 0", m0.row == anim.DEATH && m0.col == 0)
    check("morto mantem o lado e nao pisca", m0.flip && m0.visible)
    m.since_end = 0.35
    check("a morte avanca a 10 fps", anim.pose(m).col == 3)
    m.since_end = 5.0
    check("a morte segura o ultimo frame", anim.pose(m).col == 6)

    let v: wld.World = posed(vec.V(0.0, 1.0), STILL, 0.0)
    v.screen = 3
    v.since_end = 5.0
    check("na vitoria o jogador fica parado, nao morto", anim.pose(v).row == anim.IDLE_DOWN)

    // andando sem atirar, o passo manda na direcao; a mira so manda parado ou
    // atirando. Sem isso, passar pelo cursor vira o sprite para tras.
    let wr: anim.Pose = anim.pose(posed(LEFT, RIGHT, 0.0))
    check("andando para a direita com a mira atras olha para a direita", wr.row == anim.WALK_SIDE && !wr.flip)
    let wl: anim.Pose = anim.pose(posed(RIGHT, LEFT, 0.0))
    check("andando para a esquerda com a mira atras espelha", wl.row == anim.WALK_SIDE && wl.flip)
    let wu: anim.Pose = anim.pose(posed(RIGHT, UP, 0.0))
    check("andando para cima mirando de lado usa andar de costas", wu.row == anim.WALK_UP && !wu.flip)
    let wd: anim.Pose = anim.pose(posed(UP, DOWN, 0.0))
    check("andando para baixo mirando para cima usa andar frontal", wd.row == anim.WALK_DOWN)
    let ws: wld.World = posed(LEFT, RIGHT, 0.0)
    ws.player.fire_cd = 0.1
    let wsp: anim.Pose = anim.pose(ws)
    check("atirando enquanto anda, a mira manda", wsp.row == anim.SHOOT_SIDE && wsp.flip)
    let wv: wld.World = posed(DOWN, RIGHT, 0.0)
    wv.player.fire_cd = 0.1
    let wvp: anim.Pose = anim.pose(wv)
    check("atirando para baixo enquanto anda de lado usa andar frontal", wvp.row == anim.WALK_DOWN && !wvp.flip)
end

func test_enemy_anim() -> void
    print("enemy anim")
    let a: wld.Enemy = combat.make_enemy(0, vec.V(100.0, 200.0))
    let b: wld.Enemy = combat.make_enemy(0, vec.V(340.0, 200.0))
    let a2: wld.Enemy = combat.make_enemy(0, vec.V(100.0, 200.0))
    check("a fase da passada vem da posicao de spawn", a.phase != b.phase && a.phase == a2.phase)
    check("a fase e uma fracao do ciclo", a.phase >= 0.0 && a.phase < 1.0 && b.phase >= 0.0 && b.phase < 1.0)

    let e: wld.Enemy = combat.make_enemy(0, vec.V(0.0, 0.0))
    e.phase = 0.0
    e.vel = vec.V(90.0, 0.0)
    let p0: anim.Pose = anim.enemy_pose(e, 0.0)
    check("chaser usa a linha do zumbi", p0.row == anim.ZOMBIE && p0.col == 0)
    check("andando para a direita nao espelha e fica visivel", !p0.flip && p0.visible)
    e.vel = vec.V(-90.0, 30.0)
    check("andando para a esquerda espelha", anim.enemy_pose(e, 0.0).flip)
    e.vel = vec.V(0.0, -90.0)
    check("subindo reto mantem o lado direito", !anim.enemy_pose(e, 0.0).flip)
    check("a passada anda a speed/10 fps: chaser a 9", anim.enemy_pose(e, 0.12).col == 1)
    check("a passada da a volta na linha", anim.enemy_pose(e, 4.0 / 9.0 + 0.01).col == 0)
    e.phase = 0.5
    check("a fase desloca o ciclo em fracao dos frames", anim.enemy_pose(e, 0.0).col == 2)
    e.flash = 0.03
    check("atingido, o inimigo some por um instante", !anim.enemy_pose(e, 0.0).visible)

    let r: wld.Enemy = combat.make_enemy(1, vec.V(0.0, 0.0))
    r.phase = 0.0
    check("rusher usa a linha do soldado", anim.enemy_pose(r, 0.0).row == anim.SOLDIER)
    check("rusher anda a 17 fps", anim.enemy_pose(r, 0.06).col == 1)
    let t: wld.Enemy = combat.make_enemy(2, vec.V(0.0, 0.0))
    check("tank usa a linha do zumbi soldado", anim.enemy_pose(t, 0.0).row == anim.ZOMBIE_SOLDIER)
    check("cada linha de inimigo tem 4 frames", length(anim.ENEMY_FRAMES) == 3 && anim.ENEMY_FRAMES[0] == 4 && anim.ENEMY_FRAMES[1] == 4 && anim.ENEMY_FRAMES[2] == 4)
    check("escala por tipo: chaser 1, rusher menor, tank maior", anim.enemy_scale(0) == 1.0 && anim.enemy_scale(1) == 0.85 && anim.enemy_scale(2) == 1.35)
end

func test_map() -> void
    print("map")
    // um bloco de 100x100 em (200, 200)
    let box: float[] = [200.0, 200.0, 100.0, 100.0]

    let longe: vec.V = level.push_out(vec.V(100.0, 100.0), 12.0, box)
    check("longe do bloco, nada muda", longe.x == 100.0 && longe.y == 100.0)
    let esq: vec.V = level.push_out(vec.V(195.0, 250.0), 12.0, box)
    check("encostando pela esquerda, sai para x = borda - raio", near(esq.x, 188.0, 0.0001) && esq.y == 250.0)
    let cima: vec.V = level.push_out(vec.V(250.0, 195.0), 12.0, box)
    check("encostando por cima, sai para y = borda - raio", cima.x == 250.0 && near(cima.y, 188.0, 0.0001))
    let dentro: vec.V = level.push_out(vec.V(292.0, 250.0), 12.0, box)
    check("centro dentro do bloco sai pela face mais proxima (direita)", near(dentro.x, 312.0, 0.0001) && dentro.y == 250.0)
    let baixo: vec.V = level.push_out(vec.V(250.0, 297.0), 12.0, box)
    check("centro dentro perto da base sai por baixo", baixo.x == 250.0 && near(baixo.y, 312.0, 0.0001))
    let quina: vec.V = level.push_out(vec.V(192.0, 192.0), 12.0, box)
    check("na quina, sai na diagonal a raio da quina", near(vec.dist(quina, vec.V(200.0, 200.0)), 12.0, 0.001) && quina.x < 200.0 && quina.y < 200.0)

    check("ponto dentro do bloco", level.inside(vec.V(250.0, 250.0), box))
    check("ponto fora do bloco", !level.inside(vec.V(150.0, 250.0), box))
    check("livre longe do bloco", level.free(vec.V(100.0, 100.0), 12.0, box))
    check("nao livre encostando no bloco", !level.free(vec.V(195.0, 250.0), 12.0, box))
    let nada: float[] = []
    check("sem obstaculos tudo e livre", level.free(vec.V(250.0, 250.0), 12.0, nada))

    // deslize: andando na diagonal contra uma parede, o jogador segue ao longo dela
    let w: wld.World = wld.new_world()
    w.obstacles = [150.0, 0.0, 100.0, 400.0]
    w.player.pos = vec.V(100.0, 100.0)
    for i in range(30) do
        combat.move_player(ref w, vec.V(1.0, 1.0), vec.V(1.0, 0.0), 0.016)
    end
    check("a parede segura o jogador", near(w.player.pos.x, 150.0 - wld.PLAYER_R, 0.0001))
    check("mas ele desliza ao longo dela", w.player.pos.y > 150.0)

    let e: wld.World = wld.new_world()
    e.obstacles = [150.0, 0.0, 100.0, 400.0]
    e.player.pos = vec.V(400.0, 100.0)
    append(ref e.enemies, combat.make_enemy(0, vec.V(160.0, 100.0)))
    combat.update_enemies(ref e, 0.016)
    let ex: float = e.enemies[0].pos.x
    let er: float = e.enemies[0].radius
    check("inimigo dentro da parede e empurrado para fora", ex <= 150.0 - er + 0.0001 || ex >= 250.0 + er - 0.0001)

    let b: wld.World = wld.new_world()
    b.obstacles = [150.0, 0.0, 100.0, 400.0]
    b.player.pos = vec.V(400.0, 300.0)
    append(ref b.bullets, wld.Bullet(vec.V(100.0, 100.0), vec.V(600.0, 0.0), 1.0, 10.0, 0))
    combat.step(ref b, vec.V(0.0, 0.0), vec.V(1.0, 0.0), false, 0.1)
    check("a bala morre ao entrar na parede", length(b.bullets) == 0)

    let k: wld.World = wld.new_world()
    k.obstacles = [0.0, 0.0, 300.0, wld.ARENA_H]      // faixa solida em toda a borda esquerda
    let ruim = 0
    for i in range(200) do
        let sp: vec.V = waves.spawn_point(k)
        if !level.free(sp, 24.0, k.obstacles) then
            ruim = ruim + 1
        end
    end
    check("spawn evita obstaculos", ruim == 0)
end

func test_level_file() -> void
    print("level file")
    let ls: string[] = ["# comentario", "", "110 165 95 1175", "  750   15 730 85  "]
    let ok: level.Loaded = level.parse(ls)
    check("parse aceita comentario, linha vazia e espacos extras", ok.ok && length(ok.rects) == 8)
    check("parse le os quatro numeros", ok.rects[0] == 110.0 && ok.rects[3] == 1175.0 && ok.rects[4] == 750.0 && ok.rects[7] == 85.0)

    let vazio: string[] = []
    let nada: level.Loaded = level.parse(vazio)
    check("arquivo vazio e um mapa sem obstaculos", nada.ok && length(nada.rects) == 0)

    let curto: string[] = ["1 2 3"]
    let c: level.Loaded = level.parse(curto)
    check("linha com tres numeros e erro", !c.ok && strings.contains(c.error, "linha 1"))
    let texto: string[] = ["# ok", "1 2 x 4"]
    let t: level.Loaded = level.parse(texto)
    check("linha com texto e erro, apontando a linha", !t.ok && strings.contains(t.error, "linha 2"))
    let neg: string[] = ["10 10 -5 20"]
    let n: level.Loaded = level.parse(neg)
    check("lado negativo ou zero e erro", !n.ok)

    let rs: float[] = [110.0, 165.0, 95.0, 1175.0, 750.0, 15.0, 730.0, 85.0]
    let txt: string = level.format(rs)
    check("format escreve inteiros, um retangulo por linha", strings.contains(txt, "110 165 95 1175\n750 15 730 85\n"))
    let volta: level.Loaded = level.parse_text(txt)
    check("format e parse fazem ida e volta", volta.ok && length(volta.rects) == 8 && volta.rects[6] == 730.0)

    let tmp: string = "data/.teste_obstacles.txt"
    check("save escreve o arquivo", level.save(tmp, rs))
    let lido: level.Loaded = level.load(tmp)
    check("load le o que save escreveu", lido.ok && length(lido.rects) == 8 && lido.rects[1] == 165.0)
    io.remove(tmp)
    let sumido: level.Loaded = level.load("data/nao_existe.txt")
    check("arquivo ausente e erro com o caminho", !sumido.ok && strings.contains(sumido.error, "nao_existe"))

    let mapa: level.Loaded = level.load(level.PATH)
    check("o mapa do jogo carrega", mapa.ok && length(mapa.rects) > 0 && length(mapa.rects) % 4 == 0)
    let fora = 0
    for i in range(length(mapa.rects) / 4) do
        let x: float = mapa.rects[i * 4]
        let y: float = mapa.rects[i * 4 + 1]
        let rw: float = mapa.rects[i * 4 + 2]
        let rh: float = mapa.rects[i * 4 + 3]
        if rw <= 0.0 || rh <= 0.0 || x < 0.0 || y < 0.0 || x + rw > wld.ARENA_W || y + rh > wld.ARENA_H then
            fora = fora + 1
        end
    end
    check("todo obstaculo tem tamanho positivo e cabe na arena", fora == 0)
    check("o ponto de partida fica livre com folga", level.free(wld.START, wld.PLAYER_R + 20.0, mapa.rects))
end

func fresh_editor() -> editor.Editor
    // A = 200x100 em (100, 100); B = 50x30 dentro de A
    let rs: float[] = [100.0, 100.0, 200.0, 100.0, 150.0, 120.0, 50.0, 30.0]
    return editor.new_editor(rs, 1000.0, 800.0)
end

func rect_is(ed: editor.Editor, i: int, x: float, y: float, w: float, h: float) -> bool
    return ed.rects[i * 4] == x && ed.rects[i * 4 + 1] == y && ed.rects[i * 4 + 2] == w && ed.rects[i * 4 + 3] == h
end

func test_editor() -> void
    print("editor")
    let ed: editor.Editor = fresh_editor()
    check("pick escolhe o menor retangulo que contem o ponto", editor.pick(ed.rects, 160.0, 130.0) == 1)
    check("pick acha o grande fora do pequeno", editor.pick(ed.rects, 120.0, 110.0) == 0)
    check("pick fora de tudo da -1", editor.pick(ed.rects, 500.0, 500.0) == -1)

    check("alca 0 no canto superior esquerdo", editor.handle_at(ed.rects, 0, 100.0, 100.0) == 0)
    check("alca 1 no meio de cima", editor.handle_at(ed.rects, 0, 200.0, 100.0) == 1)
    check("alca 2 no canto superior direito", editor.handle_at(ed.rects, 0, 300.0, 100.0) == 2)
    check("alca 3 no meio da direita", editor.handle_at(ed.rects, 0, 300.0, 150.0) == 3)
    check("alca 4 no canto inferior direito", editor.handle_at(ed.rects, 0, 300.0, 200.0) == 4)
    check("alca 5 no meio de baixo", editor.handle_at(ed.rects, 0, 200.0, 200.0) == 5)
    check("alca 6 no canto inferior esquerdo", editor.handle_at(ed.rects, 0, 100.0, 200.0) == 6)
    check("alca 7 no meio da esquerda", editor.handle_at(ed.rects, 0, 100.0, 150.0) == 7)
    check("no centro nao ha alca", editor.handle_at(ed.rects, 0, 200.0, 150.0) == -1)
    check("a alca pega com tolerancia", editor.handle_at(ed.rects, 0, 305.0, 203.0) == 4)
    check("sem selecao nao ha alca", editor.handle_at(ed.rects, -1, 100.0, 100.0) == -1)

    // criar por arraste
    editor.press(ref ed, 400.0, 400.0)
    check("press em area vazia entra no modo criar", ed.mode == 3)
    editor.drag(ref ed, 450.0, 430.0)
    editor.release(ref ed)
    check("o arraste criou um retangulo novo, selecionado", length(ed.rects) == 12 && ed.sel == 2 && rect_is(ed, 2, 400.0, 400.0, 50.0, 30.0))
    check("criar marca como nao salvo e entra no desfazer", ed.dirty && length(ed.undo) == 1 && ed.mode == 0)

    let up: editor.Editor = fresh_editor()
    editor.press(ref up, 500.0, 500.0)
    editor.drag(ref up, 480.0, 470.0)
    editor.release(ref up)
    check("arrastar para cima e para a esquerda normaliza", rect_is(up, 2, 480.0, 470.0, 20.0, 30.0))

    let tiny: editor.Editor = fresh_editor()
    editor.press(ref tiny, 600.0, 600.0)
    editor.drag(ref tiny, 602.0, 601.0)
    editor.release(ref tiny)
    check("arraste minusculo nao cria nada", length(tiny.rects) == 8 && tiny.sel == -1 && !tiny.dirty && length(tiny.undo) == 0)

    let frac: editor.Editor = fresh_editor()
    editor.press(ref frac, 400.4, 400.6)
    editor.drag(ref frac, 450.3, 430.7)
    editor.release(ref frac)
    check("coordenadas sao arredondadas para inteiros", rect_is(frac, 2, 400.0, 401.0, 50.0, 30.0))

    // mover
    let mv: editor.Editor = fresh_editor()
    editor.press(ref mv, 120.0, 110.0)
    check("press dentro seleciona e entra no modo mover", mv.sel == 0 && mv.mode == 1)
    editor.drag(ref mv, 130.0, 115.0)
    check("mover desloca pelo delta do mouse", rect_is(mv, 0, 110.0, 105.0, 200.0, 100.0))
    editor.drag(ref mv, -500.0, -500.0)
    check("mover nao sai da arena pela esquerda", rect_is(mv, 0, 0.0, 0.0, 200.0, 100.0))
    editor.drag(ref mv, 5000.0, 5000.0)
    check("mover nao sai da arena pela direita", rect_is(mv, 0, 800.0, 700.0, 200.0, 100.0))
    editor.release(ref mv)
    check("mover marca como nao salvo e guarda um desfazer", mv.dirty && length(mv.undo) == 1)

    let click: editor.Editor = fresh_editor()
    editor.press(ref click, 120.0, 110.0)
    editor.release(ref click)
    check("clique sem arrastar so seleciona: nada a desfazer", click.sel == 0 && !click.dirty && length(click.undo) == 0)
    editor.press(ref click, 700.0, 700.0)
    editor.release(ref click)
    check("clique em area vazia limpa a selecao", click.sel == -1 && length(click.rects) == 8)

    // redimensionar
    let rz: editor.Editor = fresh_editor()
    rz.sel = 0
    editor.press(ref rz, 300.0, 150.0)
    check("press numa alca entra no modo redimensionar", rz.mode == 2 && rz.handle == 3)
    editor.drag(ref rz, 340.0, 150.0)
    editor.release(ref rz)
    check("alca da direita estica a largura", rect_is(rz, 0, 100.0, 100.0, 240.0, 100.0))

    let fl: editor.Editor = fresh_editor()
    fl.sel = 0
    editor.press(ref fl, 100.0, 150.0)
    editor.drag(ref fl, 350.0, 150.0)
    editor.release(ref fl)
    check("passar do lado oposto inverte em vez de ficar negativo", rect_is(fl, 0, 300.0, 100.0, 50.0, 100.0))

    let nw: editor.Editor = fresh_editor()
    nw.sel = 0
    editor.press(ref nw, 100.0, 100.0)
    editor.drag(ref nw, 90.0, 80.0)
    editor.release(ref nw)
    check("canto superior esquerdo move dois lados", rect_is(nw, 0, 90.0, 80.0, 210.0, 120.0))

    let zero: editor.Editor = fresh_editor()
    zero.sel = 0
    editor.press(ref zero, 300.0, 150.0)
    editor.drag(ref zero, 100.0, 150.0)
    editor.release(ref zero)
    check("encolher a nada restaura o retangulo", rect_is(zero, 0, 100.0, 100.0, 200.0, 100.0) && length(zero.undo) == 0)

    let lim: editor.Editor = fresh_editor()
    lim.sel = 0
    editor.press(ref lim, 300.0, 200.0)
    editor.drag(ref lim, 2000.0, 2000.0)
    editor.release(ref lim)
    check("redimensionar para na borda da arena", rect_is(lim, 0, 100.0, 100.0, 900.0, 700.0))

    // apagar, duplicar, empurrar, desfazer
    let del: editor.Editor = fresh_editor()
    del.sel = 1
    editor.delete_sel(ref del)
    check("apagar remove o selecionado", length(del.rects) == 4 && del.sel == -1 && del.dirty && rect_is(del, 0, 100.0, 100.0, 200.0, 100.0))
    editor.delete_sel(ref del)
    check("apagar sem selecao nao faz nada", length(del.rects) == 4 && length(del.undo) == 1)

    let dup: editor.Editor = fresh_editor()
    dup.sel = 0
    editor.duplicate_sel(ref dup)
    check("duplicar copia deslocado e seleciona a copia", length(dup.rects) == 12 && dup.sel == 2 && rect_is(dup, 2, 116.0, 116.0, 200.0, 100.0))

    let nd: editor.Editor = fresh_editor()
    nd.sel = 1
    editor.nudge(ref nd, 1.0, 0.0)
    check("empurrar move um pixel", rect_is(nd, 1, 151.0, 120.0, 50.0, 30.0))
    editor.nudge(ref nd, -1000.0, 0.0)
    check("empurrar respeita a arena", rect_is(nd, 1, 0.0, 120.0, 50.0, 30.0))
    check("empurrar guarda um desfazer por passo", length(nd.undo) == 2)
    editor.undo(ref nd)
    check("desfazer volta um passo", rect_is(nd, 1, 151.0, 120.0, 50.0, 30.0) && length(nd.undo) == 1)
    editor.undo(ref nd)
    editor.undo(ref nd)
    check("desfazer com a pilha vazia nao quebra", rect_is(nd, 1, 150.0, 120.0, 50.0, 30.0) && length(nd.undo) == 0)

    let un: editor.Editor = fresh_editor()
    editor.press(ref un, 400.0, 400.0)
    editor.drag(ref un, 450.0, 430.0)
    editor.release(ref un)
    editor.undo(ref un)
    check("desfazer uma criacao remove o retangulo", length(un.rects) == 8 && un.sel == -1)
end

test_vec()
test_rng()
test_world()
test_move()
test_fire()
test_enemies()
test_hits()
test_waves()
test_upgrades()
test_flow()
test_anim()
test_enemy_anim()
test_map()
test_level_file()
test_editor()
report()
