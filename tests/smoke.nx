// tests/smoke.nx — abre a janela e percorre o caminho de desenho de verdade:
// jogo com os tres tipos de inimigo em cena, e depois cada um dos tres
// paineis, e o quadro do editor de colisao. Pega erro de quadro que os
// testes sem janela nao alcancam.
use sys
use github_com.estevaofon.noxy_game_engine as game
use src.vec as vec
use src.world as wld
use src.combat as combat
use src.waves as waves
use src.upgrades as up
use src.flow as flow
use src.level as level
use src.editor as editor
use src.render as render

let loaded: level.Loaded = level.load(level.PATH)
if !loaded.ok then
    print(loaded.error)
    sys.exit(1)
end

game.init(960, 640, "smoke")
game.set_fps(60)
render.load()

let w: wld.World = wld.new_world()
w.obstacles = loaded.rects
render.toggle_obstacles()        // o overlay tambem e caminho de desenho
flow.begin(ref w)
w.wave = 6
w.player.shots = 3
w.shake = 14.0
append(ref w.enemies, combat.make_enemy(0, vec.V(w.player.pos.x + 120.0, w.player.pos.y)))
append(ref w.enemies, combat.make_enemy(1, vec.V(w.player.pos.x - 120.0, w.player.pos.y + 40.0)))
append(ref w.enemies, combat.make_enemy(2, vec.V(w.player.pos.x, w.player.pos.y - 130.0)))

let telas: int[] = [0, 1, 2, 3]
let nomes: string[] = ["jogo", "upgrade", "game over", "vitoria"]
let quadros = 0

for t in range(length(telas)) do
    w.screen = telas[t]
    if w.screen == 1 then
        w.offers = up.offer()
    end
    for f in range(20) do
        if w.screen == 0 then
            flow.advance(ref w, vec.V(1.0, 0.5), vec.V(1.0, -0.3), true, -1, false, 0.016)
        end
        render.frame(w)
        game.flip()
        quadros = quadros + 1
    end
    print(f"  tela '{nomes[t]}' desenhada")
end

// o editor: um retangulo selecionado (alcas), o ponto de partida e o HUD
let ed: editor.Editor = editor.new_editor(w.obstacles, wld.ARENA_W, wld.ARENA_H)
ed.sel = 0
ed.dirty = true
let cam: vec.V = render.clamp_camera(vec.V(wld.START.x - wld.VIEW_W / 2.0, wld.START.y - wld.VIEW_H / 2.0))
for f in range(20) do
    render.editor_frame(ed, cam, vec.V(cam.x + 100.0, cam.y + 100.0), "smoke: mensagem de status")
    game.flip()
    quadros = quadros + 1
end
print("  editor desenhado")

game.quit()
print(f"smoke ok: {quadros} quadros nas 4 telas e no editor, {length(w.enemies)} inimigos, {w.kills} abates")
